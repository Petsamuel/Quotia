{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quotia",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Builds the Dockerfile in this repo and runs it as a container the Worker
  // can forward requests to. max_instances is 1 so the app's in-memory caches
  // stay warm on a single instance; raise it if you need the concurrency.
  "containers": [
    {
      "class_name": "QuotiaContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  // Containers are addressed through a Durable Object; QuotiaContainer in
  // worker/index.js extends the Container class from @cloudflare/containers.
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTIA_CONTAINER",
        "class_name": "QuotiaContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotiaContainer"]
    }
  ]
}
